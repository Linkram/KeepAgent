<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          The quickjs-ng sandbox service runs in a separate process so a
          crashing or hanging add-on cannot take the app down (ADR-0001).
        -->
        <service
            android:name="io.keepagent.runtime.js.JsSandboxService"
            android:exported="false"
            android:process=":js" />
    </application>
</manifest>
